// ---------------------------------------------------------------------------
// 30. Hospitalisation
// ---------------------------------------------------------------------------
model Hospitalisation {
  id            String                @id @default(uuid())
  patientId     String                @map("patient_id")
  doctorId      String                @map("doctor_id")
  institutionId String?               @map("institution_id")
  room          String?
  bed           String?
  admissionDate DateTime              @map("admission_date")
  dischargeDate DateTime?             @map("discharge_date")
  reason        String
  diagnosis     String?
  status        HospitalisationStatus @default(en_cours)
  notes         String?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  // Relations
  patient          Patient                          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor           Doctor                           @relation(fields: [doctorId], references: [id])
  institution      Institution?                     @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  vitalSigns       HospitalisationVital[]
  medications      HospitalisationMedication[]
  evolutionNotes   EvolutionNote[]
  carePlanItems    CarePlanItem[]
  nurseAssignments HospitalisationNurseAssignment[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@map("hospitalisations")
}

// ---------------------------------------------------------------------------
// 31. HospitalisationVital
// ---------------------------------------------------------------------------
model HospitalisationVital {
  id                String   @id @default(uuid())
  hospitalisationId String   @map("hospitalisation_id")
  temperature       Float?
  systolic          Int?
  diastolic         Int?
  heartRate         Int?     @map("heart_rate")
  spO2              Int?     @map("sp_o2")
  glycemia          Float?
  weight            Float?
  nurseId           String?  @map("nurse_id")
  nurseName         String?  @map("nurse_name")
  notes             String?
  recordedAt        DateTime @default(now()) @map("recorded_at")

  // Relations
  hospitalisation Hospitalisation @relation(fields: [hospitalisationId], references: [id], onDelete: Cascade)
  nurse           Nurse?          @relation(fields: [nurseId], references: [id], onDelete: SetNull)

  @@index([hospitalisationId])
  @@map("hospitalisation_vitals")
}

// ---------------------------------------------------------------------------
// 32. HospitalisationMedication
// ---------------------------------------------------------------------------
model HospitalisationMedication {
  id                String          @id @default(uuid())
  hospitalisationId String          @map("hospitalisation_id")
  medication        String
  dosage            String?
  route             MedicationRoute @default(PO)
  nurseId           String?         @map("nurse_id")
  administeredBy    String?         @map("administered_by")
  notes             String?
  administeredAt    DateTime        @default(now()) @map("administered_at")

  // Relations
  hospitalisation Hospitalisation @relation(fields: [hospitalisationId], references: [id], onDelete: Cascade)
  nurse           Nurse?          @relation(fields: [nurseId], references: [id], onDelete: SetNull)

  @@index([hospitalisationId])
  @@map("hospitalisation_medications")
}

// ---------------------------------------------------------------------------
// 33. EvolutionNote
// ---------------------------------------------------------------------------
model EvolutionNote {
  id                String   @id @default(uuid())
  hospitalisationId String   @map("hospitalisation_id")
  doctorName        String   @map("doctor_name")
  content           String
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  hospitalisation Hospitalisation @relation(fields: [hospitalisationId], references: [id], onDelete: Cascade)

  @@index([hospitalisationId])
  @@map("evolution_notes")
}

// ---------------------------------------------------------------------------
// 34. Nurse
// ---------------------------------------------------------------------------
model Nurse {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  institutionId String?  @map("institution_id")
  specialty     String? // ex: "soins généraux", "pédiatrie", "urgences"
  licenseNumber String?  @unique @map("license_number")
  isVerified    Boolean  @default(false) @map("is_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  user                       User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution                Institution?                     @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  vitalsRecorded             HospitalisationVital[]
  medicationsGiven           HospitalisationMedication[]
  carePlanExecutions         CarePlanExecution[]
  hospitalisationAssignments HospitalisationNurseAssignment[]
  initiatedConsultations     Consultation[]                   @relation("NurseInitiatedConsultations")
  transferredConsultations   Consultation[]                   @relation("NurseTransferredConsultations")
  accessRequests             AccessRequest[]

  @@index([institutionId])
  @@index([userId])
  @@map("nurses")
}

// ---------------------------------------------------------------------------
// 34b. HospitalisationNurseAssignment — Assignation infirmier ↔ hospitalisation
// ---------------------------------------------------------------------------
model HospitalisationNurseAssignment {
  id                String   @id @default(uuid())
  hospitalisationId String   @map("hospitalisation_id")
  nurseId           String   @map("nurse_id")
  assignedAt        DateTime @default(now()) @map("assigned_at")
  assignedById      String?  @map("assigned_by_id")

  hospitalisation Hospitalisation @relation(fields: [hospitalisationId], references: [id], onDelete: Cascade)
  nurse           Nurse           @relation(fields: [nurseId], references: [id], onDelete: Cascade)

  @@unique([hospitalisationId, nurseId])
  @@index([nurseId])
  @@map("hospitalisation_nurse_assignments")
}

// ---------------------------------------------------------------------------
// 35. CarePlanItem — Cahier de charges : tâches prescrites par le médecin
// ---------------------------------------------------------------------------
enum CarePlanItemType {
  medication // Administrer un médicament
  vital_check // Prendre les paramètres vitaux
  care_task // Soin infirmier (ex: changement pansement, toilette)
}

model CarePlanItem {
  id                String           @id @default(uuid())
  hospitalisationId String           @map("hospitalisation_id")
  type              CarePlanItemType
  title             String // ex: "Paracétamol 1g", "Prise de tension"
  description       String? // Instructions détaillées
  medication        String? // Nom du médicament (si type = medication)
  dosage            String? // ex: "500mg", "1g"
  route             MedicationRoute? // PO, IV, IM...
  frequency         String? // ex: "3x/jour", "toutes les 8h"
  scheduledTimes    String?          @map("scheduled_times") // ex: "08:00,14:00,20:00"
  startDate         DateTime         @default(now()) @map("start_date")
  endDate           DateTime?        @map("end_date")
  isActive          Boolean          @default(true) @map("is_active")
  createdAt         DateTime         @default(now()) @map("created_at")

  // Relations
  hospitalisation Hospitalisation     @relation(fields: [hospitalisationId], references: [id], onDelete: Cascade)
  executions      CarePlanExecution[]

  @@index([hospitalisationId])
  @@map("care_plan_items")
}

// ---------------------------------------------------------------------------
// 36. CarePlanExecution — Exécution d'une tâche par l'infirmier(e)
// ---------------------------------------------------------------------------
model CarePlanExecution {
  id             String   @id @default(uuid())
  carePlanItemId String   @map("care_plan_item_id")
  nurseId        String   @map("nurse_id")
  executedAt     DateTime @default(now()) @map("executed_at")
  notes          String? // Observations de l'infirmier
  // For vital checks, store recorded values
  temperature    Float?
  systolic       Int?
  diastolic      Int?
  heartRate      Int?     @map("heart_rate")
  spO2           Int?     @map("sp_o2")
  glycemia       Float?
  weight         Float?

  // Relations
  carePlanItem CarePlanItem @relation(fields: [carePlanItemId], references: [id], onDelete: Cascade)
  nurse        Nurse        @relation(fields: [nurseId], references: [id])

  @@index([carePlanItemId])
  @@index([nurseId])
  @@map("care_plan_executions")
}

// ---------------------------------------------------------------------------
// Conversation (messaging between doctor and patient)
// ---------------------------------------------------------------------------
model Conversation {
  id            String    @id @default(uuid())
  patientUserId String    @map("patient_user_id")
  doctorUserId  String    @map("doctor_user_id")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  patientUser User      @relation("PatientConversations", fields: [patientUserId], references: [id], onDelete: Cascade)
  doctorUser  User      @relation("DoctorConversations", fields: [doctorUserId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([patientUserId, doctorUserId])
  @@index([patientUserId])
  @@index([doctorUserId])
  @@map("conversations")
}

// ---------------------------------------------------------------------------
// Message
// ---------------------------------------------------------------------------
model Message {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  senderUserId   String    @map("sender_user_id")
  content        String
  isRead         Boolean   @default(false) @map("is_read")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderUserId])
  @@map("messages")
}

// ---------------------------------------------------------------------------
