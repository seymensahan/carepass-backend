// ---------------------------------------------------------------------------
// 38. Voucher
// ---------------------------------------------------------------------------
model Voucher {
  id                String    @id @default(uuid())
  code              String    @unique
  type              String // "patient", "doctor", "nurse"
  discountPercent   Int       @default(100) @map("discount_percent")
  durationMonths    Int       @default(6) @map("duration_months")
  isUsed            Boolean   @default(false) @map("is_used")
  usedById          String?   @map("used_by_id")
  usedAt            DateTime? @map("used_at")
  createdById       String    @map("created_by_id")
  assignedByAgentId String?   @map("assigned_by_agent_id")
  onboardingId      String?   @map("onboarding_id")
  expiresAt         DateTime? @map("expires_at")
  batchId           String?   @map("batch_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

