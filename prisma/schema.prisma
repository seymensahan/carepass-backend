  @@map("vouchers")
}

// ---------------------------------------------------------------------------
// Wallet — doctor wallet for referral earnings
// ---------------------------------------------------------------------------
model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

// ---------------------------------------------------------------------------
// WalletTransaction — wallet transaction history
// ---------------------------------------------------------------------------
enum WalletTransactionType {
  referral_earning // earned from patient referral
  subscription_debit // annual 10,000 FCFA deduction
  withdrawal // payout to Mobile Money
  manual_credit // manual adjustment by admin
}

model WalletTransaction {
  id            String                @id @default(uuid())
  walletId      String                @map("wallet_id")
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(12, 2)
  description   String?
  referenceId   String?               @map("reference_id") // paymentId or payoutId
  balanceBefore Decimal               @map("balance_before") @db.Decimal(12, 2)
  balanceAfter  Decimal               @map("balance_after") @db.Decimal(12, 2)
  createdAt     DateTime              @default(now()) @map("created_at")

  // Relations
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([createdAt])
  @@map("wallet_transactions")
}

// ---------------------------------------------------------------------------
// ReferralCode — doctor promo codes for patient referrals
// ---------------------------------------------------------------------------
model ReferralCode {
  id             String   @id @default(uuid())
  doctorUserId   String   @unique @map("doctor_user_id")
  code           String   @unique
  totalReferrals Int      @default(0) @map("total_referrals")
  totalEarnings  Decimal  @default(0) @map("total_earnings") @db.Decimal(12, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  doctorUser User       @relation(fields: [doctorUserId], references: [id], onDelete: Cascade)
  referrals  Referral[]

  @@index([code])
  @@map("referral_codes")
}

// ---------------------------------------------------------------------------
// Referral — tracks which patient was referred by which doctor
// ---------------------------------------------------------------------------
model Referral {
  id               String   @id @default(uuid())
  referralCodeId   String   @map("referral_code_id")
  patientUserId    String   @map("patient_user_id")
  paymentId        String?  @map("payment_id") // the initial payment that triggered the referral
  doctorEarning    Decimal  @default(0) @map("doctor_earning") @db.Decimal(12, 2)
  platformEarning  Decimal  @default(0) @map("platform_earning") @db.Decimal(12, 2)
  isInitialPayment Boolean  @default(true) @map("is_initial_payment")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  patientUser  User         @relation("ReferredPatient", fields: [patientUserId], references: [id], onDelete: Cascade)

  @@unique([referralCodeId, patientUserId])
  @@index([patientUserId])
  @@map("referrals")
}

// ---------------------------------------------------------------------------
// InstitutionReferralCode — referral code shared by all members of an
// institution (admin, doctors, nurses). Patients who sign up with this code
// credit the institution's wallet (50% of the first payment) instead of an
// individual doctor.
// ---------------------------------------------------------------------------
model InstitutionReferralCode {
  id             String   @id @default(uuid())
  institutionId  String   @unique @map("institution_id")
  code           String   @unique
  totalReferrals Int      @default(0) @map("total_referrals")
  totalEarnings  Decimal  @default(0) @map("total_earnings") @db.Decimal(12, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  institution         Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionReferrals InstitutionReferral[]

  @@index([code])
  @@map("institution_referral_codes")
}

// ---------------------------------------------------------------------------
// InstitutionReferral — tracks which patient was referred by which institution
// ---------------------------------------------------------------------------
model InstitutionReferral {
  id                       String   @id @default(uuid())
  institutionReferralCodeId String  @map("institution_referral_code_id")
  patientUserId            String   @map("patient_user_id")
  paymentId                String?  @map("payment_id")
  institutionEarning       Decimal  @default(0) @map("institution_earning") @db.Decimal(12, 2)
  platformEarning          Decimal  @default(0) @map("platform_earning") @db.Decimal(12, 2)
  isInitialPayment         Boolean  @default(true) @map("is_initial_payment")
  createdAt                DateTime @default(now()) @map("created_at")

  // Relations
  institutionReferralCode InstitutionReferralCode @relation(fields: [institutionReferralCodeId], references: [id], onDelete: Cascade)
  patientUser             User                    @relation("InstitutionReferredPatient", fields: [patientUserId], references: [id], onDelete: Cascade)

  @@unique([institutionReferralCodeId, patientUserId])
  @@index([patientUserId])
  @@map("institution_referrals")
}

// ============================================================================
// FIELD AGENTS — Terrain campaign management
// ============================================================================

enum FieldVisitStatus {
  planned
  in_progress
  completed
  cancelled
}

enum FieldVisitOutcome {
  interested
  not_interested
  follow_up
  onboarded
}

enum OnboardingStatus {
  pending
  in_progress
  completed
  rejected
}

enum DoctorSpecialty {
  dentiste
  gynecologue
  pediatre
  generaliste
  ophtalmologue
}

// ---------------------------------------------------------------------------
// FieldAgent
// ---------------------------------------------------------------------------
model FieldAgent {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  zone      String?
  city      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fieldVisits FieldVisit[]
  onboardings UserOnboarding[]

  @@index([userId])
  @@map("field_agents")
}

// ---------------------------------------------------------------------------
// FieldVisit — terrain visits by agents
// ---------------------------------------------------------------------------
model FieldVisit {
  id          String             @id @default(uuid())
  agentId     String             @map("agent_id")
  targetName  String             @map("target_name")
  targetPhone String?            @map("target_phone")
  targetRole  String             @map("target_role") // "patient", "doctor", "nurse"
  location    String? // adresse ou lieu de la visite
  city        String?
  status      FieldVisitStatus   @default(planned)
  outcome     FieldVisitOutcome?
  notes       String?
  scheduledAt DateTime?          @map("scheduled_at")
  checkInLat  Float?             @map("check_in_lat")
  checkInLng  Float?             @map("check_in_lng")
  checkInAt   DateTime?          @map("check_in_at")
  checkOutLat Float?             @map("check_out_lat")
  checkOutLng Float?             @map("check_out_lng")
  checkOutAt  DateTime?          @map("check_out_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  // Relations
  agent       FieldAgent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  onboardings UserOnboarding[]

  @@index([agentId])
  @@index([status])
  @@index([scheduledAt])
  @@map("field_visits")
}

// ---------------------------------------------------------------------------
// UserOnboarding — tracking user registration by field agents
// ---------------------------------------------------------------------------
model UserOnboarding {
  id              String           @id @default(uuid())
  agentId         String           @map("agent_id")
  fieldVisitId    String?          @map("field_visit_id")
  userName        String           @map("user_name")
  userPhone       String           @map("user_phone")
  userEmail       String?          @map("user_email")
  userRole        String           @map("user_role") // "patient", "doctor", "nurse"
  doctorSpecialty DoctorSpecialty? @map("doctor_specialty")
  city            String?
  zone            String?
  status          OnboardingStatus @default(pending)
  appDownloaded   Boolean          @default(false) @map("app_downloaded")
  accountCreated  Boolean          @default(false) @map("account_created")
  voucherRedeemed Boolean          @default(false) @map("voucher_redeemed")
  rejectionReason String?          @map("rejection_reason")
  completedAt     DateTime?        @map("completed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  // Relations
  agent      FieldAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  fieldVisit FieldVisit? @relation(fields: [fieldVisitId], references: [id], onDelete: SetNull)
  vouchers   Voucher[]

  @@index([agentId])
  @@index([userRole])
  @@index([status])
  @@map("user_onboardings")
}

// ============================================================================
// CRON JOBS — Observability for scheduled background tasks
// ============================================================================

enum CronJobStatus {
  running
  success
  partial_failure
  failed
}

enum CronJobTrigger {
  scheduled
  manual
}

/**
 * CronJobExecution — one row per cron run, persisted so super admin can audit
 * what ran, when, and what it affected. Write-heavy but capped by retention.
 */
model CronJobExecution {
  id             String         @id @default(uuid())
  jobName        String         @map("job_name") // e.g. "subscription-renewal"
  trigger        CronJobTrigger @default(scheduled)
  status         CronJobStatus  @default(running)
  startedAt      DateTime       @default(now()) @map("started_at")
  finishedAt     DateTime?      @map("finished_at")
  durationMs     Int?           @map("duration_ms")
  itemsProcessed Int            @default(0) @map("items_processed")
  itemsAffected  Int            @default(0) @map("items_affected")
  details        Json? // { renewed, failed, expired, userIds: [...] }
  errorMessage   String?        @map("error_message")

  @@index([jobName])
  @@index([startedAt])
  @@index([status])
  @@map("cron_job_executions")
}
