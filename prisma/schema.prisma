// ============================================================================
// CARYPASS Digital Health Platform - Prisma Schema
// Database: Neon PostgreSQL (Cameroon)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  patient
  doctor
  nurse
  institution_admin
  lab
  insurance
  super_admin
  field_agent
}

enum Gender {
  M
  F
}

enum InstitutionType {
  hospital
  clinic
  laboratory
  pharmacy
  insurance
}

enum ConsultationType {
  consultation
  suivi
  urgence
  bilan
  specialiste
}

enum Severity {
  legere
  moderee
  severe
}

enum ConsultationStatus {
  en_cours
  terminee
  annulee
}

enum PrescriptionStatus {
  active
  completed
  cancelled
}

enum LabCategory {
  hematologie
  biochimie
  imagerie
  microbiologie
  autre
}

enum LabResultStatus {
  pending
  validated
  rejected
}

enum VaccinationStatus {
  done
  scheduled
  overdue
}

enum ConditionStatus {
  active
  resolved
  managed
}

enum AccessRequestStatus {
  pending
  approved
  denied
}

enum AppointmentStatus {
  scheduled
  confirmed
  cancelled
  completed
}

enum NotificationType {
  info
  warning
  success
  error
}

enum ClaimStatus {
  pending
  approved
  rejected
  paid
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

enum FlowIntensity {
  light
  medium
  heavy
}

enum PregnancyStatus {
  en_cours
  terminee
  fausse_couche
  avortement
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum HospitalisationStatus {
  en_cours
  terminee
  transferee
}

enum MedicationRoute {
  PO
  IV
  IM
  SC
  inhalation
  topical
}

// ============================================================================
// MODELS
// ============================================================================

// ---------------------------------------------------------------------------
// 1. User
// ---------------------------------------------------------------------------
model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String    @map("password_hash")
  role             Role
  availableRoles   Role[]    @default([]) @map("available_roles")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  phone            String?
  avatarUrl        String?   @map("avatar_url")
  isActive         Boolean   @default(true) @map("is_active")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  twoFactorMethod  String?   @map("two_factor_method") // "sms"
  isPromoter       Boolean   @default(false) @map("is_promoter")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  patient                 Patient?
  doctor                  Doctor?
  nurse                   Nurse?
  notifications           Notification[]
  subscriptions           Subscription[]
  auditLogs               AuditLog[]
  institutionAdmin        Institution?             @relation("InstitutionAdmin")
  insuranceCompany        InsuranceCompany?
  systemSettingsUpdated   SystemSetting[]
  labResultsUploaded      LabResult[]              @relation("UploadedBy")
  labOrdersPickedUp       LabOrder[]               @relation("LabOrderPickedUp")
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  payments                Payment[]
  sentInvitations         Invitation[]             @relation("InvitedByUser")
  otpCodes                OtpCode[]
  patientConversations    Conversation[]           @relation("PatientConversations")
  doctorConversations     Conversation[]           @relation("DoctorConversations")
  sentMessages            Message[]                @relation("SentMessages")
  vouchersUsed            Voucher[]                @relation("VoucherUsedBy")
  vouchersCreated         Voucher[]                @relation("VoucherCreatedBy")
  fieldAgent              FieldAgent?
  vouchersAssigned        Voucher[]                @relation("VoucherAssignedByAgent")
  wallet                  Wallet?
  referralCode            ReferralCode?
  referredBy              Referral[]               @relation("ReferredPatient")
  institutionReferredBy   InstitutionReferral[]    @relation("InstitutionReferredPatient")

  @@map("users")
}

// ---------------------------------------------------------------------------
// 2. Patient
// ---------------------------------------------------------------------------
model Patient {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  carypassId        String   @unique @map("carepass_id")
  dateOfBirth       DateTime @map("date_of_birth")
  gender            Gender?
  bloodGroup        String?  @map("blood_group")
  genotype          String?
  address           String?
  city              String?
  region            String?
  emergencyToken    String?  @unique @map("emergency_token")
  referredByCode    String?  @map("referred_by_code")
  referredByInstitutionCode String? @map("referred_by_institution_code")
  isMinor           Boolean  @default(false) @map("is_minor")
  managedByGuardian Boolean  @default(false) @map("managed_by_guardian")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultations     Consultation[]
  prescriptions     Prescription[]
  labResults        LabResult[]
  labOrders         LabOrder[]
  vaccinations      Vaccination[]
  allergies         Allergy[]
  medicalConditions MedicalCondition[]
  children          Child[]
  emergencyContacts EmergencyContact[]
  accessGrants      AccessGrant[]
  accessRequests    AccessRequest[]
  appointments      Appointment[]
  insuranceClaims   InsuranceClaim[]
  menstrualCycles   MenstrualCycle[]
  pregnancies       Pregnancy[]
  hospitalisations  Hospitalisation[]

  // Guardian relationships
  guardianships LegalGuardian[] @relation("PatientGuardianships") // guardians of this patient
  guardianOf    LegalGuardian[] @relation("GuardianOf") // patients this one is a guardian of

  // Set if this Patient was created by promoting a Child (back-reference)
  promotedFromChild Child? @relation("PromotedFromChild")

  @@index([carypassId])
  @@index([userId])
  @@map("patients")
}

// ---------------------------------------------------------------------------
// LegalGuardian — links a dependent Patient (minor) to a guardian Patient (parent)
// ---------------------------------------------------------------------------
model LegalGuardian {
  id                    String    @id @default(uuid())
  dependentId           String    @map("dependent_id") // the minor / managed patient
  guardianPatientId     String    @map("guardian_patient_id") // the adult patient acting as guardian
  relationship          String    @default("parent") // parent, tuteur, curateur, autre
  isPrimary             Boolean   @default(true) @map("is_primary")
  canManage             Boolean   @default(true) @map("can_manage") // false after transfer
  transferredAt         DateTime? @map("transferred_at")
  readOnlyAfterTransfer Boolean   @default(true) @map("read_only_after_transfer") // keep view access
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  dependent Patient @relation("PatientGuardianships", fields: [dependentId], references: [id], onDelete: Cascade)
  guardian  Patient @relation("GuardianOf", fields: [guardianPatientId], references: [id], onDelete: Cascade)

  @@unique([dependentId, guardianPatientId])
  @@index([guardianPatientId])
  @@index([dependentId])
  @@map("legal_guardians")
}

// ---------------------------------------------------------------------------
// 3. Doctor
// ---------------------------------------------------------------------------
model Doctor {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id")
  specialty     String
  licenseNumber String    @unique @map("license_number")
  institutionId String?   @map("institution_id")
  bio           String?
  city          String?
  region        String?
  isVerified    Boolean   @default(false) @map("is_verified")
  verifiedAt    DateTime? @map("verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution      Institution?        @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  consultations    Consultation[]
  prescriptions    Prescription[]
  accessGrants     AccessGrant[]
  accessRequests   AccessRequest[]
  appointments     Appointment[]
  institutions     DoctorInstitution[]
  hospitalisations Hospitalisation[]
  sentInvitations  Invitation[]        @relation("DoctorInvitations")
  labOrders        LabOrder[]
  labResultsDiagnosed LabResult[]      @relation("LabResultDiagnosedBy")

  @@index([specialty])
  @@index([city])
  @@index([userId])
  @@map("doctors")
}

// ---------------------------------------------------------------------------
// 4. Institution
// ---------------------------------------------------------------------------
model Institution {
  id                 String          @id @default(uuid())
  name               String
  type               InstitutionType
  registrationNumber String?         @unique @map("registration_number")
  address            String?
  city               String?
  region             String?
  phone              String?
  email              String?
  logoUrl            String?         @map("logo_url")
  isVerified         Boolean         @default(false) @map("is_verified")
  isSuspended        Boolean         @default(false) @map("is_suspended")
  suspendedAt        DateTime?       @map("suspended_at")
  suspensionReason   String?         @map("suspension_reason")
  adminUserId        String?         @unique @map("admin_user_id")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  // Relations
  admin              User?                 @relation("InstitutionAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  doctors            Doctor[]
  nurses             Nurse[]
  doctorInstitutions DoctorInstitution[]
  labResults         LabResult[]
  labOrders          LabOrder[]            @relation("LabOrderInstitution")
  hospitalisations   Hospitalisation[]
  documents          InstitutionDocument[]
  invitations        Invitation[]
  appointments       Appointment[]
  referralCode       InstitutionReferralCode?

  @@map("institutions")
}

// ---------------------------------------------------------------------------
// 4c. InstitutionDocument (documents de vérification)
// ---------------------------------------------------------------------------
model InstitutionDocument {
  id            String   @id @default(uuid())
  institutionId String   @map("institution_id")
  name          String
  type          String // autorisation_exercice, rccm, niu, autre
  fileUrl       String   @map("file_url")
  fileSize      Int?     @map("file_size")
  mimeType      String?  @map("mime_type")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@map("institution_documents")
}

// ---------------------------------------------------------------------------
// 4d. Invitation (email invitations for doctors/nurses)
// ---------------------------------------------------------------------------
model Invitation {
  id                String   @id @default(uuid())
  institutionId     String?  @map("institution_id")
  invitedByDoctorId String?  @map("invited_by_doctor_id")
  email             String
  role              Role // doctor or nurse
  token             String   @unique
  message           String?
  status            String   @default("pending") // pending, accepted, expired
  invitedById       String   @map("invited_by_id")
  expiresAt         DateTime @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  institution     Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  invitedByDoctor Doctor?      @relation("DoctorInvitations", fields: [invitedByDoctorId], references: [id], onDelete: SetNull)
  invitedBy       User         @relation("InvitedByUser", fields: [invitedById], references: [id])

  @@index([institutionId])
  @@index([invitedByDoctorId])
  @@index([token])
  @@index([email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// 4b. DoctorInstitution (join table for many-to-many)
// ---------------------------------------------------------------------------
model DoctorInstitution {
  id            String    @id @default(uuid())
  doctorId      String    @map("doctor_id")
  institutionId String    @map("institution_id")
  role          String    @default("doctor") // doctor, consultant, visiting
  // Optional override of Doctor.specialty for this specific institution.
  // Lets the same physician be "Généraliste" in solo practice and
  // "Cardiologue" in a hospital where they consult.
  specialty     String?
  isPrimary     Boolean   @default(false) @map("is_primary")
  startDate     DateTime  @default(now()) @map("start_date")
  endDate       DateTime? @map("end_date")
  isActive      Boolean   @default(true) @map("is_active")
  // Departure tracking
  departureReason String? @map("departure_reason")
  departedBy      String? @map("departed_by") // userId of admin who removed the doctor
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([doctorId, institutionId])
  @@index([doctorId])
  @@index([institutionId])
  @@map("doctor_institutions")
}

// ---------------------------------------------------------------------------
// 5. Consultation
// ---------------------------------------------------------------------------
model Consultation {
  id         String             @id @default(uuid())
  patientId  String             @map("patient_id")
  doctorId   String?            @map("doctor_id")
  date       DateTime
  type       ConsultationType   @default(consultation)
  motif      String
  symptoms   String?
  diagnosis  String?
  notes      String?
  severity   Severity?
  vitalSigns Json?              @map("vital_signs")
  status     ConsultationStatus @default(en_cours)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  // Nurse-initiated consultation fields
  initiatedByNurseId   String?   @map("initiated_by_nurse_id")
  transferredByNurseId String?   @map("transferred_by_nurse_id")
  transferredAt        DateTime? @map("transferred_at")

  // External doctor (not in CaryPass system)
  externalDoctorName      String? @map("external_doctor_name")
  externalDoctorSpecialty String? @map("external_doctor_specialty")
  externalDoctorPhone     String? @map("external_doctor_phone")

  // Relations
  patient            Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor             Doctor?          @relation(fields: [doctorId], references: [id])
  initiatedByNurse   Nurse?           @relation("NurseInitiatedConsultations", fields: [initiatedByNurseId], references: [id])
  transferredByNurse Nurse?           @relation("NurseTransferredConsultations", fields: [transferredByNurseId], references: [id])
  prescriptions      Prescription[]
  insuranceClaims    InsuranceClaim[]
  labResults         LabResult[]
  labOrders          LabOrder[]

  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@index([initiatedByNurseId])
  @@map("consultations")
}

// ---------------------------------------------------------------------------
// 6. Prescription
// ---------------------------------------------------------------------------
model Prescription {
  id             String             @id @default(uuid())
  consultationId String             @map("consultation_id")
  patientId      String             @map("patient_id")
  doctorId       String?            @map("doctor_id")
  notes          String?
  status         PrescriptionStatus @default(active)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  // Relations
  consultation Consultation       @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       Doctor?            @relation(fields: [doctorId], references: [id])
  items        PrescriptionItem[]

  @@index([consultationId])
  @@index([patientId])
  @@map("prescriptions")
}

// ---------------------------------------------------------------------------
// 7. PrescriptionItem
// ---------------------------------------------------------------------------
model PrescriptionItem {
  id             String  @id @default(uuid())
  prescriptionId String  @map("prescription_id")
  medication     String
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String?

  // Relations
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}

// ---------------------------------------------------------------------------
// 8. LabResult
// ---------------------------------------------------------------------------
model LabResult {
  id               String          @id @default(uuid())
  patientId        String          @map("patient_id")
  uploadedById     String          @map("uploaded_by_id")
  institutionId    String?         @map("institution_id")
  consultationId   String?         @map("consultation_id")
  labOrderId       String?         @unique @map("lab_order_id")
  title            String
  category         LabCategory     @default(autre)
  fileUrl          String          @map("file_url")
  fileSize         Int?            @map("file_size")
  mimeType         String?         @map("mime_type")
  date             DateTime
  notes            String?
  // Doctor's diagnosis on the result
  doctorDiagnosis  String?         @map("doctor_diagnosis")
  diagnosedAt      DateTime?       @map("diagnosed_at")
  diagnosedById    String?         @map("diagnosed_by_id")
  status           LabResultStatus @default(pending)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  // Relations
  patient      Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedBy   User            @relation("UploadedBy", fields: [uploadedById], references: [id])
  diagnosedBy  Doctor?         @relation("LabResultDiagnosedBy", fields: [diagnosedById], references: [id], onDelete: SetNull)
  institution  Institution?    @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  consultation Consultation?   @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  labOrder     LabOrder?       @relation(fields: [labOrderId], references: [id], onDelete: SetNull)
  items        LabResultItem[]

  @@index([patientId])
  @@index([consultationId])
  @@index([date])
  @@map("lab_results")
}

// ---------------------------------------------------------------------------
// 8b. LabOrder — Prescription d'analyse envoyée aux laboratoires
// ---------------------------------------------------------------------------
enum LabOrderStatus {
  pending // créée, attend qu'un labo la prenne
  in_progress // labo a commencé
  completed // résultat uploadé
  cancelled
}

model LabOrder {
  id               String         @id @default(uuid())
  patientId        String         @map("patient_id")
  doctorId         String         @map("doctor_id")
  consultationId   String?        @map("consultation_id")
  labInstitutionId String?        @map("lab_institution_id") // labo cible (optionnel — sinon n'importe quel labo peut prendre)
  examType         String         @map("exam_type") // ex: "NFS", "Glycémie à jeun", "IRM cérébrale"
  category         LabCategory    @default(autre)
  urgent           Boolean        @default(false)
  notes            String?
  status           LabOrderStatus @default(pending)
  pickedUpById     String?        @map("picked_up_by_id") // user (lab) qui a pris l'order
  pickedUpAt       DateTime?      @map("picked_up_at")
  completedAt      DateTime?      @map("completed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relations
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor         Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  labInstitution Institution?  @relation("LabOrderInstitution", fields: [labInstitutionId], references: [id], onDelete: SetNull)
  pickedUpBy     User?         @relation("LabOrderPickedUp", fields: [pickedUpById], references: [id], onDelete: SetNull)
  result         LabResult?

  @@index([patientId])
  @@index([doctorId])
  @@index([labInstitutionId])
  @@index([status])
  @@map("lab_orders")
}

// ---------------------------------------------------------------------------
// 9. LabResultItem
// ---------------------------------------------------------------------------
model LabResultItem {
  id             String  @id @default(uuid())
  labResultId    String  @map("lab_result_id")
  name           String
  value          String
  unit           String?
  referenceRange String? @map("reference_range")
  isAbnormal     Boolean @default(false) @map("is_abnormal")

  // Relations
  labResult LabResult @relation(fields: [labResultId], references: [id], onDelete: Cascade)

  @@map("lab_result_items")
}

// ---------------------------------------------------------------------------
// 10. Vaccination
// ---------------------------------------------------------------------------
model Vaccination {
  id             String            @id @default(uuid())
  patientId      String            @map("patient_id")
  childId        String?           @map("child_id")
  name           String
  date           DateTime
  boosterDate    DateTime?         @map("booster_date")
  lot            String?
  administeredBy String?           @map("administered_by")
  location       String?
  status         VaccinationStatus @default(done)
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  child   Child?  @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("vaccinations")
}

// ---------------------------------------------------------------------------
// 11. Allergy
// ---------------------------------------------------------------------------
model Allergy {
  id          String    @id @default(uuid())
  patientId   String    @map("patient_id")
  name        String
  severity    Severity?
  reaction    String?
  diagnosedAt DateTime? @map("diagnosed_at")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("allergies")
}

// ---------------------------------------------------------------------------
// 12. MedicalCondition
// ---------------------------------------------------------------------------
model MedicalCondition {
  id          String          @id @default(uuid())
  patientId   String          @map("patient_id")
  name        String
  diagnosedAt DateTime?       @map("diagnosed_at")
  status      ConditionStatus @default(active)
  treatment   String?
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("medical_conditions")
}

// ---------------------------------------------------------------------------
// 13. Child
// ---------------------------------------------------------------------------
model Child {
  id                String   @id @default(uuid())
  parentId          String   @map("parent_id")
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  dateOfBirth       DateTime @map("date_of_birth")
  gender            Gender?
  bloodGroup        String?  @map("blood_group")
  genotype          String?
  weightKg          Decimal? @map("weight_kg") @db.Decimal(5, 2)
  heightCm          Decimal? @map("height_cm") @db.Decimal(5, 1)
  dependentType     String?  @default("child") @map("dependent_type")
  // Set when this Child has been promoted to a full Patient account.
  // Lets us fetch all medical data (consultations, allergies, etc.) from the
  // linked Patient when displaying the child detail page.
  promotedPatientId String?  @unique @map("promoted_patient_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  parent          Patient       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  promotedPatient Patient?      @relation("PromotedFromChild", fields: [promotedPatientId], references: [id], onDelete: SetNull)
  vaccinations    Vaccination[]

  @@map("children")
}

// ---------------------------------------------------------------------------
// 14. EmergencyContact
// ---------------------------------------------------------------------------
model EmergencyContact {
  id           String   @id @default(uuid())
  patientId    String   @map("patient_id")
  name         String
  relationship String?
  phone        String
  email        String?
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

// ---------------------------------------------------------------------------
// 15. AccessGrant
// ---------------------------------------------------------------------------
model AccessGrant {
  id        String    @id @default(uuid())
  patientId String    @map("patient_id")
  doctorId  String    @map("doctor_id")
  grantedAt DateTime  @default(now()) @map("granted_at")
  expiresAt DateTime? @map("expires_at")
  scope     String    @default("full")
  isActive  Boolean   @default(true) @map("is_active")
  revokedAt DateTime? @map("revoked_at")

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([patientId, doctorId])
  @@map("access_grants")
}

// ---------------------------------------------------------------------------
// 16. AccessRequest
// ---------------------------------------------------------------------------
model AccessRequest {
  id                String              @id @default(uuid())
  doctorId          String?             @map("doctor_id")
  nurseId           String?             @map("nurse_id")
  patientId         String              @map("patient_id")
  patientCarypassId String              @map("patient_carepass_id")
  reason            String?
  status            AccessRequestStatus @default(pending)
  requestedAt       DateTime            @default(now()) @map("requested_at")
  respondedAt       DateTime?           @map("responded_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  // Relations
  doctor  Doctor? @relation(fields: [doctorId], references: [id], onDelete: Cascade)
