    "cache-manager": "^7.2.8",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fast-csv": "^5.0.5",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "joi": "^18.0.2",
    "node-appwrite": "^14.0.0",
    "passport": "^0.7.0",
